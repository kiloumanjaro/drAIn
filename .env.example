# Copy to .env.local (Next.js reads that file). Values for the local Supabase
# stack come from `npx supabase start`. Never commit .env.local.

# Supabase project (local: http://127.0.0.1:54321 and its anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The simulation API (drAIn-backend), without a trailing slash
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Mapbox public token for the map
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Public address of the site, for canonical links and robots.txt (optional on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini key for /api/chatbot (server only)
GEMINI_API_KEY=

# Signs the chatbot's conversation history; 32+ random characters
CHATBOT_HISTORY_SECRET=

# true reports Content-Security-Policy violations instead of enforcing them
CSP_REPORT_ONLY=false
